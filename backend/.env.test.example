# A SEPARATE Supabase project used only by `npm test`. The tests ERASE this database on every run.
# Never point these at the project in .env.
TEST_DATABASE_URL="postgresql://postgres.<test-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
TEST_DIRECT_URL="postgresql://postgres.<test-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
