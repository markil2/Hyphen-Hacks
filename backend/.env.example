PORT=8000

# ── Supabase Postgres ──────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs → Prisma.
# Pooled connection (port 6543, transaction mode) for the running API:
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ──────────────────────────────────────────────────
# Project URL (dashboard → Project Settings → API). Access tokens are verified with the project's JWKS.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Only for projects still using the legacy shared JWT secret (Project Settings → JWT Keys). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Server-only secret key (dashboard → Project Settings → API keys → secret / service_role).
# Used only to delete a person's sign-in when they delete their account. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────────────
FRONTEND_ORIGIN="http://localhost:8081"
# true = requests without a token use the seeded demo parent (for live demos only; keep false otherwise)
DEMO_MODE=false
DEMO_EMAIL="demo@nurture.local"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Family-invitation emails
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Nurture <noreply@your-domain.com>"
APP_BASE_URL="http://localhost:8081"
PRIVACY_POLICY_VERSION="2026-10-10"
