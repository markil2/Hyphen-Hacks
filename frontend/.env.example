# Base URL of the Nurture backend API, including /api.
#   iOS Simulator / web on this computer:  http://localhost:8000/api
#   Expo Go on a real phone:               http://<your-computer's-LAN-IP>:8000/api
# Leave empty to run the offline demo (sample data stored on the device only).
EXPO_PUBLIC_API_URL=

# Supabase Auth (dashboard → Project Settings → API). Both values are public by design.
# Use the PUBLISHABLE (or legacy anon) key — never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
